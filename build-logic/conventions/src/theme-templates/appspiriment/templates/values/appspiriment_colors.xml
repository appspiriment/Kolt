<?xml version="1.0" encoding="utf-8"?>
<!--
  compose-utils — Day Theme Colours
  ════════════════════════════════════════════════════════════════════════════
  Generated by the Appspiriment convention plugin.  Edit freely — this file
  will NOT be regenerated while it exists.

  HOW OVERRIDING WORKS
  ─────────────────────
  Android's resource-merge system gives app resources priority over AAR
  resources.  Every <color name="…"> here shadows the same name inside the
  compose-utils AAR, so your brand colours propagate to all components
  automatically — no code changes required.

  DARK THEME  →  values-night/appspiriment_colors.xml
  DIMENSIONS  →  values/appspiriment_dimens.xml

  Accessed in Kotlin as Appspiriment.colors.<fieldName>
  ════════════════════════════════════════════════════════════════════════════
-->
<resources>

    <!-- ── Brand ──────────────────────────────────────────────────────────
         primary    → Appspiriment.colors.primary
         Change these two first — they drive buttons, TopBar, FABs, links. -->
    <color name="primary">#C20F2F</color>
    <color name="onPrimary">#FFFFFF</color>

    <!-- secondary  → Appspiriment.colors.secondary  (chips, toggles, etc.) -->
    <color name="secondary">#03DAC6</color>
    <color name="onSecondary">@color/onMainSurface</color>

    <!-- tertiary   → Appspiriment.colors.tertiary   (rarely used accent) -->
    <color name="tertiary">#3700B3</color>
    <color name="onTertiary">#FFFFFF</color>

    <!-- ── Surfaces ───────────────────────────────────────────────────────
         mainSurface  → Appspiriment.colors.mainSurface  (card / sheet bg)
         onMainSurface → default body text colour                          -->
    <color name="mainSurface">#FFFFFF</color>
    <color name="onMainSurface">#121212</color>

    <!-- secondarySurface → input field / subtle container backgrounds -->
    <color name="secondarySurface">#EBEBEB</color>
    <color name="onSecondarySurface">@color/onMainSurface</color>

    <!-- background / onBackground → screen background behind all cards -->
    <color name="background">#F3F3F3</color>
    <color name="onBackground">#1C1B1F</color>

    <!-- ── Card Containers ────────────────────────────────────────────────
         Three tiers (primary / secondary / tertiary) + a neutral grey tier. -->
    <color name="primaryCardContainer">#FFFFFF</color>
    <color name="onPrimaryCardContainer">@color/onMainSurface</color>
    <color name="onPrimaryCardContainerDimmed">#5D6364</color>

    <color name="secondaryCardContainer">#EBEBEB</color>
    <color name="onSecondaryCardContainer">@color/onMainSurface</color>

    <color name="tertiaryCardContainer">#EBEBEB</color>
    <color name="onTertiaryCardContainer">@color/onMainSurface</color>

    <color name="greyCardContainer">#F1F1F1</color>
    <color name="onGreyCardContainer">@color/onMainSurface</color>

    <!-- ── Semantic States ────────────────────────────────────────────────
         error / onError → validation errors, destructive actions          -->
    <color name="error">#B00020</color>
    <color name="onError">#FFFFFF</color>
    <color name="errorCardContainer">#ABFFB5B5</color>
    <color name="onErrorCardContainer">#7E0000</color>

    <!-- ── Top App Bar ────────────────────────────────────────────────────
         Defaults to the same as primary; change if your bar differs.      -->
    <color name="topAppBar">#C20F2F</color>
    <color name="onTopAppBar">#FFFFFF</color>

    <!-- ── Typography Helpers ─────────────────────────────────────────────
         disabledText → Appspiriment.colors.disabledText
         subText      → Appspiriment.colors.subText   (secondary labels)
         hintText     → Appspiriment.colors.hintText  (placeholders)
         dividerColor → Appspiriment.colors.dividerColor                   -->
    <color name="disabledText">#BDBDBD</color>
    <color name="subText">#757575</color>
    <color name="hintText">#99121212</color>
    <color name="dividerColor">#BDBDBD</color>

    <!-- ── Accent Text / Titles ───────────────────────────────────────────
         Optional — used for highlighted inline text and section titles.   -->
    <color name="accentedBlueTitle">#027DDF</color>
    <color name="accentedBlackTitle">@color/onMainSurface</color>
    <color name="accentedRedTitle">#ac081d</color>
    <color name="accentedBlueText">#027DDF</color>
    <color name="accentedRedText">#ac081d</color>
    <color name="accentedGoldText">#C46F08</color>

    <!-- ── System / Misc ──────────────────────────────────────────────────
         scrim         → modal / dialog dimming overlay
         iconTint      → default icon tint (non-primary contexts)
         drawerItem    → navigation drawer item text
         navigationBar → system navigation bar background                  -->
    <color name="scrim">#020202</color>
    <color name="iconTint">#888E92</color>
    <color name="disabledIconTint">#5D1D3B</color>
    <color name="drawerItem">#5F6368</color>
    <color name="navigationBar">#282828</color>
    <color name="bi_brand">#C20F2F</color>

</resources>
